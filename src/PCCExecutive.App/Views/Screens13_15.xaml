<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels"
                    xmlns:p="clr-namespace:PCCExecutive.App.Presentation">
    <!-- 13 Settings -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Settings" Style="{StaticResource TitleText}"/><TextBlock Text="Smart defaults first; advanced mechanics remain optional." Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Save Settings" Style="{StaticResource PrimaryButton}" Command="{Binding Shell.SaveSettingsCommand}"/></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="EXECUTION PROVIDER" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource PurpleChip}" Margin="0,12,0,8" Padding="12"><StackPanel><TextBlock Text="ChatGPT Web / Chrome" FontWeight="SemiBold"/><TextBlock Text="PRIMARY · selected by default · no API key required" Style="{StaticResource MutedText}"/></StackPanel></Border><RadioButton Content="Browser Web / Chrome" IsChecked="{Binding Shell.IsBrowserProviderSelected}"/><RadioButton Content="OpenAI API (optional)" IsChecked="{Binding Shell.IsOpenAiProviderSelected}" IsEnabled="{Binding Shell.Snapshot.ApiConfigured}"/><RadioButton Content="Hybrid (optional)" IsChecked="{Binding Shell.IsHybridProviderSelected}" IsEnabled="{Binding Shell.Snapshot.ApiConfigured}"/><TextBlock Text="API modes remain unavailable until explicitly configured." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="DISPATCH DEFAULTS" Style="{StaticResource SectionTitle}"/><TextBlock Text="Mode" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding Shell.DispatchModes}" SelectedItem="{Binding Shell.SelectedDispatchMode}"/><TextBlock Text="Base interval (seconds)" Margin="0,8,0,4"/><TextBox Text="{Binding Shell.SelectedBaseIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Max Workers (1–5)" Margin="0,8,0,4"/><TextBox Text="{Binding Shell.SelectedMaxWorkers, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Adaptive Pacing" IsChecked="{Binding Shell.SelectedAdaptivePacing}" Margin="0,8,0,0"/><CheckBox Content="Auto Pause on Limit" IsChecked="True" IsEnabled="False" ToolTip="Required safety policy; cannot be disabled."/><CheckBox Content="Auto Resume" IsChecked="{Binding Shell.SelectedAutoResume}"/><CheckBox Content="Duplicate Send Protection" IsChecked="True" IsEnabled="False" ToolTip="Required safety policy; cannot be disabled."/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="ZERO-TOUCH UX" Style="{StaticResource SectionTitle}"/><TextBlock Text="Routine events stay quiet" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock Text="Worker completion, wave completion, recovered transient errors, cooldown recovery and successful conversation rollover do not demand modal acknowledgement." Style="{StaticResource MutedText}"/><TextBlock Text="Attention Center" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBlock Text="Only unavoidable sign-in/challenge, missing authority, irreversible approval, or genuine product decisions are escalated." Style="{StaticResource MutedText}"/></StackPanel></Border>
            </Grid>
        </StackPanel></ScrollViewer>
    </DataTemplate>
    <!-- 14 Update Center -->
    <DataTemplate DataType="{x:Type vm:UpdateCenterViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Update Center" Style="{StaticResource TitleText}"/><TextBlock Text="Verified in-place updates with backup, migration, restart and rollback state." Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Check for Updates" Command="{Binding Shell.CheckForUpdatesCommand}" ToolTip="No governed update source is configured." ToolTipService.ShowOnDisabled="True"/></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="VERSION" Style="{StaticResource SectionTitle}"/><TextBlock Text="Current" Style="{StaticResource MutedText}" Margin="0,12,0,2"/><TextBlock Text="{Binding Shell.Snapshot.Update.CurrentVersion}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Available" Style="{StaticResource MutedText}" Margin="0,14,0,2"/><TextBlock Text="{Binding Shell.Snapshot.Update.NewVersion}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Brush.Purple}"/><Button Content="Install Update &amp; Restart" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" Command="{Binding Shell.InstallUpdateCommand}" ToolTip="No verified staged update is ready." ToolTipService.ShowOnDisabled="True"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="UPDATE READINESS" Style="{StaticResource SectionTitle}"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Package verification" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.Update.PackageVerification}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,14"/><TextBlock Text="Backup" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.Update.BackupState}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,14"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Migration" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.Update.MigrationState}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,14"/><TextBlock Text="Rollback" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.Update.RollbackState}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,14"/></StackPanel></Grid><Border Style="{StaticResource SeparatorLine}"/><TextBlock Text="The primary user action is intentionally simple. Update execution remains disabled until the updater proves package verification, preservation and migration readiness." Style="{StaticResource MutedText}"/></StackPanel></Border></Grid>
        </StackPanel></ScrollViewer>
    </DataTemplate>
    <!-- 15 Attention Center -->
    <DataTemplate DataType="{x:Type vm:AttentionCenterViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Attention Center" Style="{StaticResource TitleText}"/><TextBlock Text="Only genuinely unavoidable operator actions belong here." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource HeroCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Shell.Snapshot.AttentionCountText}" FontSize="58" FontWeight="SemiBold" Foreground="{Binding Shell.Snapshot.AttentionAccent}" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Shell.Snapshot.AttentionHeadline}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Shell.Snapshot.AttentionSubhead}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Grid></Border>
            <ItemsControl ItemsSource="{Binding Shell.Snapshot.AttentionItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" BorderBrush="#684552"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WHAT HAPPENED" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding WhatHappened}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,12"/><TextBlock Text="WHY USER ACTION IS REQUIRED" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding WhyActionRequired}" Margin="0,5,0,12"/><TextBlock Text="EXACT LOCATION" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ExactLocation}" Foreground="{StaticResource Brush.Cyan}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.Shell.OpenAttentionLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}"/><TextBlock Text="One clear action only" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AUTOMATIC · NO ATTENTION ITEM" Style="{StaticResource SectionTitle}"/><TextBlock Text="Worker complete · wave complete · transient ChatGPT error recovered · cooldown recovered · conversation rollover succeeded · safe retry succeeded" Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ConversationHistoryViewModel}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14"><TextBlock Text="Conversation History" Style="{StaticResource TitleText}"/><TextBlock Text="Durable logical lineage only; credentials, cookies and tokens are never displayed." Style="{StaticResource MutedText}"/></StackPanel>
            <ListView Grid.Row="1" ItemsSource="{Binding Shell.Snapshot.ConversationHistory}"><ListView.View><GridView><GridViewColumn Header="Agent" DisplayMemberBinding="{Binding LogicalAgent}" Width="120"/><GridViewColumn Header="Sequence" DisplayMemberBinding="{Binding Sequence}" Width="80"/><GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="120"/><GridViewColumn Header="Provider identity" DisplayMemberBinding="{Binding ProviderIdentity}" Width="300"/><GridViewColumn Header="Created" DisplayMemberBinding="{Binding CreatedAt}" Width="170"/><GridViewColumn Header="Retired" DisplayMemberBinding="{Binding RetiredAt}" Width="170"/><GridViewColumn Header="Rollover reason" DisplayMemberBinding="{Binding RolloverReason}" Width="220"/></GridView></ListView.View></ListView>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
