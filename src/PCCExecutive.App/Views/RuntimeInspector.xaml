<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:RuntimeInspectorViewModel}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Runtime Inspector" Style="{StaticResource TitleText}"/><TextBlock Text="Screen 16 · redacted diagnostic authority for operator behavior and runtime decisions." Style="{StaticResource MutedText}"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/><Button Content="Copy Snapshot" Command="{Binding CopySnapshotCommand}" Margin="0,0,8,0"/><Button Content="Save Snapshot" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSnapshotCommand}"/></StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource HeroCard}" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="CURRENT RUNTIME STATE / NEXT ACTION" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CurrentState}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding LastExportStatus}" Foreground="{StaticResource Brush.Cyan}" Margin="0,6,0,0"/></StackPanel></Border>
            <TabControl Grid.Row="2">
                <TabItem Header="Prerequisite Matrix"><DataGrid ItemsSource="{Binding Prerequisites}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="100"/><DataGridTextColumn Header="Prerequisite" Binding="{Binding Prerequisite}" Width="*"/><DataGridCheckBoxColumn Header="Pass" Binding="{Binding Satisfied}" Width="70"/><DataGridTextColumn Header="Reason code" Binding="{Binding ReasonCode}" Width="180"/><DataGridCheckBoxColumn Header="Automatic" Binding="{Binding AutomaticallyRecoverable}" Width="90"/><DataGridCheckBoxColumn Header="Human" Binding="{Binding HumanActionRequired}" Width="80"/></DataGrid.Columns></DataGrid></TabItem>
                <TabItem Header="Operator Behavior"><DataGrid ItemsSource="{Binding BehaviorTimeline}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="UTC time" Binding="{Binding Event.Timestamp}" Width="180"/><DataGridTextColumn Header="Screen" Binding="{Binding Event.Screen}" Width="130"/><DataGridTextColumn Header="Control / command" Binding="{Binding Event.Command}" Width="150"/><DataGridCheckBoxColumn Header="Allowed" Binding="{Binding Event.Allowed}" Width="75"/><DataGridTextColumn Header="Reason" Binding="{Binding Event.ReasonCode}" Width="160"/><DataGridTextColumn Header="Result" Binding="{Binding Event.Summary}" Width="*"/><DataGridTextColumn Header="Correlation" Binding="{Binding Event.CorrelationId}" Width="220"/></DataGrid.Columns></DataGrid></TabItem>
                <TabItem Header="Recovery / Decisions"><DataGrid ItemsSource="{Binding RecoveryTimeline}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="UTC time" Binding="{Binding Event.Timestamp}" Width="180"/><DataGridTextColumn Header="Kind" Binding="{Binding Event.Kind}" Width="130"/><DataGridTextColumn Header="Classification" Binding="{Binding ExceptionClassification}" Width="160"/><DataGridTextColumn Header="Reason" Binding="{Binding Event.ReasonCode}" Width="180"/><DataGridTextColumn Header="Decision / transition" Binding="{Binding Event.Summary}" Width="*"/><DataGridTextColumn Header="Correlation" Binding="{Binding Event.CorrelationId}" Width="220"/></DataGrid.Columns></DataGrid></TabItem>
                <TabItem Header="Browser Evidence"><DataGrid ItemsSource="{Binding BrowserEvidence}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Profile/source" Binding="{Binding ProfileSource}" Width="190"/><DataGridTextColumn Header="Runtime ID" Binding="{Binding RuntimeId}" Width="180"/><DataGridTextColumn Header="Role" Binding="{Binding LogicalRole}" Width="100"/><DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/><DataGridTextColumn Header="Endpoint" Binding="{Binding EndpointHealth}" Width="130"/><DataGridTextColumn Header="Ownership proof" Binding="{Binding OwnershipProof}" Width="*"/><DataGridCheckBoxColumn Header="Personal Chrome excluded" Binding="{Binding PersonalChromeExcluded}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
            </TabControl>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
