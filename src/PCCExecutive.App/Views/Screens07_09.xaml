<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels"
                    xmlns:p="clr-namespace:PCCExecutive.App.Presentation">
    <DataTemplate DataType="{x:Type vm:WaveSummaryViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Wave Summary" Style="{StaticResource TitleText}"/><TextBlock Text="Reconcile Worker results before the next Manager decision." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WORKER RESULTS" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.Snapshot.Workers}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LogicalName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Role}" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource Brush.Cyan}"/><TextBlock Grid.Column="3" Text="{Binding Progress, StringFormat={}{0}%, TargetNullValue=—}"/><TextBlock Grid.Column="4" Text="{Binding LatestHandoff, TargetNullValue='NOT AVAILABLE'}" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Reconcile &amp; Send to Manager" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Command="{Binding Shell.ReconcileWaveCommand}" ToolTip="Requires a selected project and a proven PCC-owned Manager session. The runtime decides whether Manager or Worker reconciliation is currently valid." ToolTipService.ShowOnDisabled="True"/></StackPanel></Border><StackPanel Grid.Column="1"><Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="WAVE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.CurrentWave}" Style="{StaticResource MetricValue}"/><TextBlock Text="Verified completion is not inferred from Worker DONE claims." Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BLOCKERS" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.BlockerCountText}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Brush.Red}"/><TextBlock Text="Runtime-reported blocker count." Style="{StaticResource MutedText}"/></StackPanel></Border></StackPanel></Grid>
        </StackPanel></ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TaskBoardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Task Board" Style="{StaticResource TitleText}"/><TextBlock Text="Human-readable queue. Done never implies evidence-verified unless the evidence field confirms it." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <ItemsControl ItemsSource="{Binding Shell.Snapshot.Tasks}" Margin="0,0,0,12"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="0"/></DataTemplate></ItemsControl.ItemTemplate><ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Visible"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ItemsControl"><Border Style="{StaticResource Card}" Padding="18"><StackPanel HorizontalAlignment="Center"><TextBlock Text="NO ACTIVE TASKS" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="No task rows are synthesized. Tasks appear only when supplied by the runtime snapshot." Style="{StaticResource MutedText}" Margin="0,5,0,0" TextAlignment="Center"/></StackPanel></Border></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers></Style></ItemsControl.Style></ItemsControl>
            <UniformGrid Columns="4"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TO DO" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.TodoTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Priority}" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="IN PROGRESS" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.InProgressTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}" BorderBrush="#4D3380"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Owner}" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TESTING" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.TestingTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}" BorderBrush="#1D6685"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Owner}" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DONE" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.DoneTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}" BorderBrush="#1B5A4C"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding EvidenceVerified, StringFormat={}Evidence verified: {0}}" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></UniformGrid>
        </StackPanel></ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EvidenceVerificationViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Evidence &amp; Verification" Style="{StaticResource TitleText}"/><TextBlock Text="Only proven evidence is shown as VERIFIED. Runtime PASS claims without exact verification provenance stay PENDING." Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Run Verification" Style="{StaticResource PrimaryButton}" Command="{Binding Shell.RunVerificationCommand}" ToolTip="Select a project first. Verification uses the current selected project's live PCC/GitHub baseline." ToolTipService.ShowOnDisabled="True"/></Grid>
            <UniformGrid Columns="4"><ItemsControl ItemsSource="{Binding Shell.Snapshot.EvidenceGates}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding VisibleScoreText}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding VisibleState}" FontWeight="SemiBold"/><TextBlock Text="{Binding Evidence}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></UniformGrid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="VERIFIED COMPLETION" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.VerifiedCompletionText}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Brush.Purple}"/><TextBlock Text="Canonical completion engine only" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="MANAGER ESTIMATE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.ManagerEstimateText}" Style="{StaticResource MetricValue}"/><TextBlock Text="Displayed separately by design" Style="{StaticResource MutedText}"/></StackPanel></Border></Grid>
        </StackPanel></ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
