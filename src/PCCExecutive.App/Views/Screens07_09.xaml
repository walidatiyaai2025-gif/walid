<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels">
    <!-- 07 Wave Summary -->
    <DataTemplate DataType="{x:Type vm:WaveSummaryViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Wave Summary" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Reconcile real Worker results before the Manager makes the next-wave decision." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="WORKER RESULTS" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Shell.Snapshot.Workers}">
                                <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LogicalName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Role}" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource Brush.Green}"/><TextBlock Grid.Column="3" Text="{Binding Progress, StringFormat={}{0}%}"/><TextBlock Grid.Column="4" Text="{Binding LatestHandoff}" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Reconcile &amp; Send to Manager" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Command="{Binding Shell.ReconcileWaveCommand}" ToolTip="{Binding Shell.ReconcileDisabledReason}"/>
                            <TextBlock Text="{Binding Shell.ReconcileDisabledReason}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="WAVE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.CurrentWave}" Style="{StaticResource MetricValue}"/><TextBlock Text="Worker progress and handoffs remain evidence inputs; they do not set Verified Completion." Style="{StaticResource MutedText}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BLOCKERS" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.BlockerCountText}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Brush.Red}"/></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- 08 Task Board -->
    <DataTemplate DataType="{x:Type vm:TaskBoardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Task Board" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Canonical task state is read-only here. Filters never mutate persisted orchestration state." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
                <Border Style="{StaticResource Card}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Worker" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Shell.TaskWorkerFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Wave" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Shell.TaskWaveFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Priority" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Shell.TaskPriorityFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="Blocker" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Shell.TaskBlockerFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TO DO" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.TodoTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Priority}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Wave, StringFormat={}Wave: {0}}" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="IN PROGRESS" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.InProgressTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}" BorderBrush="#4D3380"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Owner}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding State}" Foreground="{StaticResource Brush.Cyan}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TESTING / VALIDATING" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.TestingTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}" BorderBrush="#1D6685"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Owner}" Style="{StaticResource MutedText}"/><TextBlock Text="Evidence verification pending" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DONE · EVIDENCE VERIFIED" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.DoneTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}" BorderBrush="#1B5A4C"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding EvidenceVerified, StringFormat={}Evidence verified: {0}}" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- 09 Evidence & Verification -->
    <DataTemplate DataType="{x:Type vm:EvidenceVerificationViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Evidence &amp; Verification" Style="{StaticResource TitleText}"/><TextBlock Text="Live PCC/GitHub evidence is distinct from canonical persisted completion gates." Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Run Verification" Style="{StaticResource PrimaryButton}" Command="{Binding Shell.RunVerificationCommand}" ToolTip="{Binding Shell.VerificationDisabledReason}"/></Grid>
                <Border Style="{StaticResource HeroCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PCC SOURCE SHA" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.PccSourceSha}" TextTrimming="CharacterEllipsis" Margin="0,6,12,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="REPOSITORY / BRANCH" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.Repository}" Margin="0,6,12,0"/><TextBlock Text="{Binding Shell.Snapshot.Branch}" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="HEAD / PR" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.HeadSha}" Margin="0,6,12,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Shell.Snapshot.PullRequest}" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="CI / FRESHNESS" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.CiState}" Margin="0,6,0,0"/><TextBlock Text="{Binding Shell.Snapshot.EvidenceFreshness}" Style="{StaticResource MutedText}"/></StackPanel></Grid></Border>
                <ItemsControl ItemsSource="{Binding Shell.Snapshot.EvidenceGates}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="350"><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding State}" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,3"/><TextBlock Text="{Binding Freshness, StringFormat={}Freshness: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ExactHead, StringFormat={}Exact head: {0}}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Evidence}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="VERIFIED COMPLETION" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.VerifiedCompletionText}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Brush.Purple}"/><TextBlock Text="{Binding Shell.Snapshot.CompletionMode}" Style="{StaticResource MutedText}"/><TextBlock Text="99% stays CLOSURE MODE; only CompletionEngine VerifiedComplete may show 100% VERIFIED." Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="MANAGER ESTIMATE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.ManagerEstimateText}" Style="{StaticResource MetricValue}"/><TextBlock Text="Planning signal only · never merged into Verified Completion" Style="{StaticResource MutedText}"/></StackPanel></Border></Grid>
                <TextBlock Text="{Binding Shell.VerificationDisabledReason}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="4,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
