<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:ChromeConnectionViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Chrome Connection" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Browser-first execution provider · ChatGPT Web / Chrome · no API key required" Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><Border Style="{StaticResource HeroCard}"><StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Brush.PurpleGradient}" Margin="0,0,14,0"><TextBlock Text="◉" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="ChatGPT Web / Chrome" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="PRIMARY EXECUTION PROVIDER" Style="{StaticResource SectionTitle}" Foreground="#BFA7FF"/></StackPanel></StackPanel>
                    <UniformGrid Columns="3" Margin="0,18,0,0"><StackPanel><TextBlock Text="PCC RUNTIME" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.BrowserProviderState}" FontWeight="SemiBold" Margin="0,4,8,0" TextWrapping="Wrap"/></StackPanel><StackPanel><TextBlock Text="LOGIN" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.LoginState}" FontWeight="SemiBold" Margin="0,4,8,0"/></StackPanel><StackPanel><TextBlock Text="ADAPTER" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.AdapterState}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></UniformGrid>
                    <UniformGrid Columns="3" Margin="0,14,0,0"><StackPanel><TextBlock Text="MANAGER" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.ManagerReadiness}" FontWeight="SemiBold" Margin="0,4,8,0"/></StackPanel><StackPanel><TextBlock Text="WORKERS" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.WorkerReadiness}" FontWeight="SemiBold" Margin="0,4,8,0"/></StackPanel><StackPanel><TextBlock Text="OWNED SESSIONS" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.PccOwnedSessionCountText}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></UniformGrid>
                    <WrapPanel Margin="0,18,0,0"><Button Content="Connect / Recover Chrome" Style="{StaticResource PrimaryButton}" Command="{Binding Shell.ConnectChromeCommand}" Margin="0,0,8,8"/><Button Content="Open Browser" Command="{Binding Shell.OpenSessionCommand}" CommandParameter="{Binding Shell.ManagerSession.RuntimeId}" Margin="0,0,8,8"/><Button Content="Bring to Front" Command="{Binding Shell.BringSessionToFrontCommand}" CommandParameter="{Binding Shell.ManagerSession.RuntimeId}" Margin="0,0,8,8"/><Button Content="Retry Health" Command="{Binding Shell.RetryHealthCommand}" Margin="0,0,8,8"/><Button Content="Refresh State" Command="{Binding Shell.RefreshCommand}" Margin="0,0,8,8"/></WrapPanel>
                </StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="HEALTH / RECOVERY" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.HealthText}" FontSize="20" FontWeight="SemiBold" Foreground="{Binding Shell.Snapshot.HealthAccent}" Margin="0,7,0,3"/><TextBlock Text="{Binding Shell.Snapshot.OperatorMessage}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.AutomaticRecoveryAction}" Margin="0,10,0,0"/></StackPanel></Border></StackPanel>
                <StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SAFETY CONTRACT" Style="{StaticResource SectionTitle}"/><TextBlock Text="PCC-OWNED SESSIONS ONLY" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="Personal Chrome is excluded. Unknown ownership never becomes killable." Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PROVIDER STATUS" Style="{StaticResource SectionTitle}"/><TextBlock Text="ChatGPT Web / Chrome" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Primary · selected by default · no API key required" Style="{StaticResource MutedText}"/><TextBlock Text="OpenAI API / Hybrid" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock Text="Optional and disabled until explicitly configured." Style="{StaticResource MutedText}"/></StackPanel></Border></StackPanel>
            </Grid>
        </StackPanel></ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProjectSelectionViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Project Selection" Style="{StaticResource TitleText}"/><TextBlock Text="Resolve a live PCC project, alias, standalone project, family or variant. No demo projects are synthesized." Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Refresh PCC Projects" Command="{Binding Shell.RefreshCommand}"/></Grid>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Shell.ProjectQuery, UpdateSourceTrigger=PropertyChanged}" MinWidth="420" ToolTip="Project ID, display name, alias or routed variant"/><Button Grid.Column="1" Content="Resolve Project" Style="{StaticResource PrimaryButton}" Command="{Binding Shell.ResolveProjectCommand}" Margin="8,0,0,0"/></Grid></Border>
            <Border Style="{StaticResource Card}" BorderBrush="#3B4960"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ROUTING STATE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.ProjectResolutionState}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DETAIL" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.ProjectResolutionMessage}" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border>
            <ItemsControl ItemsSource="{Binding Shell.Snapshot.Projects}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="360" MinHeight="185"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Repository}" Style="{StaticResource MutedText}"/></StackPanel><Border Grid.Column="1" Style="{StaticResource GreenChip}"><TextBlock Text="{Binding State}" Foreground="{StaticResource Brush.Green}" FontSize="10"/></Border></Grid><StackPanel Grid.Row="1" Margin="0,14"><TextBlock Text="{Binding Model, StringFormat={}Model: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Scope, StringFormat={}Scope: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding RoutingState, StringFormat={}Routing: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding VerifiedCompletion, StringFormat={}Verified: {0}%}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brush.Purple}" Margin="0,6,0,0"/></StackPanel><Button Grid.Row="2" Content="Open Project" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.Shell.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Executive Dashboard" Style="{StaticResource TitleText}"/><TextBlock Text="Evidence-backed project truth with low-noise autonomous operation." Style="{StaticResource MutedText}"/></StackPanel><Border Grid.Column="1" Style="{StaticResource PurpleChip}" VerticalAlignment="Center"><TextBlock Text="{Binding Shell.Snapshot.AutopilotState}" Foreground="#D8C7FF" FontWeight="SemiBold"/></Border></Grid>
            <UniformGrid Columns="6" Margin="0,0,0,4"><Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="VERIFIED COMPLETION" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.VerifiedCompletionText}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Brush.Purple}"/><TextBlock Text="{Binding Shell.Snapshot.CompletionMode}" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MANAGER ESTIMATE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.ManagerEstimateText}" Style="{StaticResource MetricValue}"/><TextBlock Text="Planning signal only" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CURRENT WAVE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.CurrentWave}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACTIVE WORKERS" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.ActiveWorkersText}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Brush.Green}"/><TextBlock Text="Maximum 5" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="P0 / P1" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Shell.Snapshot.P0CountText}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Brush.Red}"/><TextBlock Text=" / " Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding Shell.Snapshot.P1CountText}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Brush.Amber}"/></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ATTENTION" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.AttentionCountText}" Style="{StaticResource MetricValue}" Foreground="{Binding Shell.Snapshot.AttentionAccent}"/><TextBlock Text="Operator actions" Style="{StaticResource MutedText}"/></StackPanel></Border></UniformGrid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WORKER POOL" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.Snapshot.Workers}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding LogicalName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Role}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Progress, StringFormat={}{0}%}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brush.Cyan}" Margin="0,10,0,0"/><TextBlock Text="{Binding State}" Style="{StaticResource MutedText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CHATGPT HEALTH" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.HealthText}" FontSize="21" FontWeight="SemiBold" Foreground="{Binding Shell.Snapshot.HealthAccent}" Margin="0,7,0,3"/><TextBlock Text="{Binding Shell.Snapshot.OperatorMessage}" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LOOP GUARD" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.LoopGuardState}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,3"/><TextBlock Text="No stability claim is made without canonical loop evidence." Style="{StaticResource MutedText}"/></StackPanel></Border></StackPanel></Grid>
            <Border Style="{StaticResource HeroCard}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PROJECT / EVIDENCE IDENTITY" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.ProjectDisplayName}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2"/><TextBlock Text="{Binding Shell.Snapshot.Repository}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.PccSourceSha, StringFormat={}PCC source: {0}}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="LIVE SOURCE EVIDENCE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.HeadSha, StringFormat={}HEAD: {0}}" Margin="0,7,0,2"/><TextBlock Text="{Binding Shell.Snapshot.PullRequest, StringFormat={}PR: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.CiState, StringFormat={}CI: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.EvidenceFreshness, StringFormat={}Freshness: {0}}" Style="{StaticResource MutedText}"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><StackPanel><TextBlock Text="CURRENT EXECUTION FLOW" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.CurrentExecutionFlow}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding Shell.Snapshot.StartupRecoveryState}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
