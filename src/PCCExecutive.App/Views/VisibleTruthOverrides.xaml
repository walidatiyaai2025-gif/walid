<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels">
    <!-- Focused UI-truth override for Project Selection. The runtime distinguishes refresh from selection;
         the visible label must do the same. -->
    <DataTemplate DataType="{x:Type vm:ProjectSelectionViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Project Selection" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Resolve a new project through live PCC routing, or refresh only the currently selected project." Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh Selected Project" Command="{Binding Shell.RefreshCommand}"
                            ToolTip="Select or resolve a project first. Refresh never starts a different project."
                            ToolTipService.ShowOnDisabled="True"/>
                </Grid>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RESOLVE PCC PROJECT" Style="{StaticResource SectionTitle}"/>
                            <TextBox x:Name="ProjectLookup" MinWidth="420" Margin="0,8,0,0" ToolTip="Enter a PCC Project ID, display name or routed alias."/>
                            <TextBlock Text="Resolve &amp; Open is the mutating project-selection/start action. Refresh only re-reads the existing selected project." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Resolve &amp; Open Project" Command="{Binding Shell.SelectProjectCommand}" CommandParameter="{Binding Text, ElementName=ProjectLookup}" Margin="12,22,0,0" VerticalAlignment="Top"
                                ToolTip="Resolves and selects the entered PCC project.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ProjectLookup}" Value="">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="ToolTip" Value="ENTER A PCC PROJECT ID, NAME OR ALIAS"/>
                                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Shell.Snapshot.Projects}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="360" MinHeight="165">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Repository}" Style="{StaticResource MutedText}"/></StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource GreenChip}"><TextBlock Text="{Binding State}" Foreground="{StaticResource Brush.Green}" FontSize="10"/></Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="VERIFIED" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding VerifiedCompletion, StringFormat={}{0}%, TargetNullValue=—}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Brush.Purple}"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="CURRENT WAVE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CurrentWave, TargetNullValue='NOT AVAILABLE'}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                    </Grid>
                                    <Button Grid.Row="2" Content="Open Project" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.Shell.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}"
                                            ToolTip="Selects/restores this project through the canonical runtime adapter."/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value><ControlTemplate TargetType="ItemsControl"><ContentControl ContentTemplate="{StaticResource EmptyStateTemplate}"/></ControlTemplate></Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
