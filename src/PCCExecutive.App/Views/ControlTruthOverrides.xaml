<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:ChromeConnectionViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Chrome Connection" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Browser-first execution provider · ChatGPT Web / Chrome · no API key required" Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource HeroCard}" Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Brush.PurpleGradient}" Margin="0,0,14,0"><TextBlock Text="◉" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="ChatGPT Web / Chrome" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="PRIMARY EXECUTION PROVIDER" Style="{StaticResource SectionTitle}" Foreground="#BFA7FF"/></StackPanel>
                            </StackPanel>
                            <Border Grid.Row="1" Style="{StaticResource SeparatorLine}"/>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Runtime" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.RuntimeStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Health" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.Snapshot.HealthText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Owned sessions" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.PccOwnedSessionCountText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid>
                            <WrapPanel Grid.Row="3" Margin="0,18,0,0">
                                <Button Content="Connect / Recover Chrome" Style="{StaticResource PrimaryButton}" Command="{Binding Shell.ConnectChromeCommand}" Margin="0,0,8,8" ToolTip="SELECT A PROJECT FIRST. This creates or recovers only PCC-owned Chrome." ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="Open PCC Browser" Command="{Binding Shell.OpenSessionCommand}" CommandParameter="{Binding Shell.ManagerSession.RuntimeId}" Margin="0,0,8,8" ToolTip="CONNECT PCC-OWNED CHROME FIRST. Requires positive ownership proof." ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="Bring to Front" Command="{Binding Shell.BringSessionToFrontCommand}" CommandParameter="{Binding Shell.ManagerSession.RuntimeId}" Margin="0,0,8,8" ToolTip="CONNECT PCC-OWNED CHROME FIRST. Requires positive ownership proof." ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="Refresh State" Command="{Binding Shell.RefreshCommand}" Margin="0,0,8,8" ToolTip="SELECT A PROJECT FIRST. Refresh re-reads the current selected project only." ToolTipService.ShowOnDisabled="True"/>
                            </WrapPanel>
                            <TextBlock Grid.Row="4" Text="Controls stay disabled until their prerequisite is proven: select a project first; browser/session actions additionally require positive PCC ownership evidence." Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SAFETY CONTRACT" Style="{StaticResource SectionTitle}"/><TextBlock Text="PCC-owned sessions only" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="Personal Chrome is excluded from PCC process controls. Unknown ownership never becomes killable." Style="{StaticResource MutedText}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OPTIONAL PROVIDERS" Style="{StaticResource SectionTitle}"/><TextBlock Text="OpenAI API" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Optional and disabled until explicitly configured." Style="{StaticResource MutedText}"/><TextBlock Text="Hybrid" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock Text="Secondary mode; never required for Browser-first operation." Style="{StaticResource MutedText}"/></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SessionMonitorViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Session Monitor" Style="{StaticResource TitleText}"/><TextBlock Text="Manager + Worker 1..5 logical sessions. Personal Chrome is never assumed to be PCC-owned." Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Kill All PCC Sessions" Style="{StaticResource DangerButton}" Command="{Binding Shell.KillAllPccSessionsCommand}" ToolTip="Requires at least one positively proven PCC-owned session. Personal or unknown Chrome is excluded; confirmation is required." ToolTipService.ShowOnDisabled="True"/></Grid>
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Background="#0F1B2C" Margin="1" Height="38"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="105"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="75"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SESSION" Style="{StaticResource SectionTitle}" Margin="12,12,0,0"/><TextBlock Grid.Column="1" Text="ROLE" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="2" Text="STATE" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="3" Text="VISIBILITY" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="4" Text="PID" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="5" Text="LAST ACTIVITY" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="6" Text="CONVERSATION / TASK" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="7" Text="ACTIONS" Style="{StaticResource SectionTitle}" Margin="8,12,156,0"/></Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Shell.Snapshot.Sessions}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="105"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="75"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LogicalName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Role}" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="2" Text="{Binding State}"/><TextBlock Grid.Column="3" Text="{Binding Visibility}"/><TextBlock Grid.Column="4" Text="{Binding ProcessId, TargetNullValue=—}"/><TextBlock Grid.Column="5" Text="{Binding LastActivity, StringFormat={}{0:HH:mm:ss}, TargetNullValue=—}" Style="{StaticResource MutedText}"/><StackPanel Grid.Column="6"><TextBlock Text="{Binding ConversationOrTask}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding IsPccOwned, StringFormat={}PCC owned: {0}}" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Column="7" Orientation="Horizontal"><Button Content="Open" Padding="9,5" Margin="0,0,4,0" Command="{Binding DataContext.Shell.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}" ToolTip="Disabled until positive PCC ownership proof exists." ToolTipService.ShowOnDisabled="True"/><Button Content="Bring to Front" Padding="9,5" Margin="0,0,4,0" Command="{Binding DataContext.Shell.BringSessionToFrontCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}" ToolTip="Disabled until positive PCC ownership proof exists." ToolTipService.ShowOnDisabled="True"/><Button Content="Hide" Padding="9,5" Margin="0,0,4,0" Command="{Binding DataContext.Shell.HideSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}" ToolTip="Disabled until positive PCC ownership proof exists." ToolTipService.ShowOnDisabled="True"/><Button Content="Restart" Padding="9,5" Margin="0,0,4,0" Command="{Binding DataContext.Shell.RestartSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}" ToolTip="Disabled until positive PCC ownership proof exists." ToolTipService.ShowOnDisabled="True"/><Button Content="Kill" Padding="9,5" Style="{StaticResource DangerButton}" Command="{Binding DataContext.Shell.KillSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}" ToolTip="Disabled until positive PCC ownership proof exists. Kill requires confirmation." ToolTipService.ShowOnDisabled="True"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </Grid>
                </Border>
                <TextBlock Text="Session actions are enabled only by positive Browser-runtime ownership evidence. Personal and unknown Chrome remain non-actionable." Style="{StaticResource MutedText}" Margin="4,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
