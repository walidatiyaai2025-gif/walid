<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels"
                    xmlns:p="clr-namespace:PCCExecutive.App.Presentation">
<BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <Style x:Key="CompactListItem" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <DataTemplate x:Key="EmptyStateTemplate">
        <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="◇" FontSize="34" Foreground="{StaticResource Brush.Purple}" HorizontalAlignment="Center"/>
                <TextBlock Text="No runtime evidence available" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <TextBlock Text="PCC Executive will populate this view when the canonical runtime adapter supplies verified state." Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="440"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
