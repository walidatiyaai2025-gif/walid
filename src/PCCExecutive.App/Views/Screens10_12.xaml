<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels">
    <!-- 10 Loop Guard -->
    <DataTemplate DataType="{x:Type vm:LoopGuardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Loop Guard &amp; Stability" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Canonical loop evidence controls continuation. The UI cannot bypass safety policy." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="LOOP GUARD STATUS" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.LoopGuardState}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brush.Green}" Margin="0,8,0,4" TextWrapping="Wrap"/><TextBlock Text="NORMAL · WATCH · STAGNATING · LOOP DETECTED · AUTO STOPPED" Style="{StaticResource MutedText}"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="MONITORING EVIDENCE" Style="{StaticResource SectionTitle}"/><TextBlock Text="Repeated task fingerprint" Margin="0,9,0,2"/><TextBlock Text="Repeated blocker / same HEAD" Margin="0,2"/><TextBlock Text="Same failed check" Margin="0,2"/><TextBlock Text="Negligible Verified Completion delta" Margin="0,2"/><TextBlock Text="Repeated Manager reassignment" Margin="0,2"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="SAFE CONTROLS" Style="{StaticResource SectionTitle}"/><WrapPanel Margin="0,10,0,0"><Button Content="Inspect" Command="{Binding Shell.InspectLoopGuardCommand}" Margin="0,0,6,6"/><Button Content="Replan" Command="{Binding Shell.ReplanLoopCommand}" Margin="0,0,6,6"/><Button Content="Resume Once" Command="{Binding Shell.ResumeLoopOnceCommand}" Margin="0,0,6,6"/><Button Content="Stop" Style="{StaticResource DangerButton}" Command="{Binding Shell.StopLoopCommand}" Margin="0,0,6,6"/></WrapPanel><TextBlock Text="{Binding Shell.LoopActionsDisabledReason}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- 11 ChatGPT Health & Recovery -->
    <DataTemplate DataType="{x:Type vm:ChatGptHealthViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ChatGPT Health &amp; Recovery" Style="{StaticResource TitleText}"/><TextBlock Text="Real semantic Browser state with conservative automatic recovery." Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Retry Health" Command="{Binding Shell.RetryHealthCommand}"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="GLOBAL HEALTH" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.HealthText}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding Shell.Snapshot.HealthAccent}" Margin="0,10,0,3"/><TextBlock Text="{Binding Shell.Snapshot.OperatorMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/><TextBlock Text="Recovery" Style="{StaticResource SectionTitle}" Margin="0,15,0,3"/><TextBlock Text="{Binding Shell.Snapshot.AutomaticRecoveryAction}" TextWrapping="Wrap"/><TextBlock Text="{Binding Shell.Snapshot.HealthScope, StringFormat={}Scope: {0}}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="{Binding Shell.Snapshot.CooldownStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="SEMANTIC STATE COVERAGE" Style="{StaticResource SectionTitle}"/><TextBlock Text="READY · SENDING · GENERATING · SLOW · THROTTLED · RATE_LIMITED" Margin="0,10,0,4" TextWrapping="Wrap"/><TextBlock Text="TEMP_ERROR · PARTIAL_RESPONSE · SESSION_EXPIRED · LOGIN_REQUIRED · CHALLENGE" Margin="0,4" TextWrapping="Wrap"/><TextBlock Text="OFFLINE · STUCK · RECOVERING · PAUSED · FAILED · DONE" Margin="0,4" TextWrapping="Wrap"/><TextBlock Text="CONTEXT_LIMIT_DETECTED · BROWSER_ADAPTER_UNCERTAIN" Margin="0,4" TextWrapping="Wrap"/><TextBlock Text="No fake timers: only runtime/service-derived cooldown information is displayed." Style="{StaticResource MutedText}" Margin="0,10,0,0"/><TextBlock Text="{Binding Shell.Snapshot.LoginState, StringFormat={}Authentication: {0}}" Margin="0,12,0,0"/><TextBlock Text="{Binding Shell.Snapshot.AdapterState, StringFormat={}Adapter: {0}}"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="RECENT RECOVERY TIMELINE" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.Snapshot.RecoveryEvents}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding State}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding At, StringFormat={}{0:HH:mm:ss}}" Style="{StaticResource MutedText}"/></Grid><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/><TextBlock Text="{Binding Automatic, StringFormat={}Automatic: {0}}" Foreground="{StaticResource Brush.Green}" FontSize="11"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Routine recovery remains inline and low-noise. Human-required login/challenge is routed to Attention Center." Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- 12 Session Monitor -->
    <DataTemplate DataType="{x:Type vm:SessionMonitorViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Session Monitor" Style="{StaticResource TitleText}"/><TextBlock Text="Manager + Worker 1..5 logical sessions. PCC ownership must be positively proven before destructive control." Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Kill All PCC Sessions" Style="{StaticResource DangerButton}" Command="{Binding Shell.KillAllPccSessionsCommand}" ToolTip="PCC-OWNED SESSIONS ONLY · unproven/personal Chrome is excluded."/></Grid>
                <Border Style="{StaticResource DangerChip}" Padding="12" Margin="0,0,0,10"><TextBlock Text="PCC-OWNED SESSIONS ONLY · UNKNOWN OR PERSONAL CHROME IS NEVER A KILL TARGET" Foreground="#FFD6DE" FontWeight="SemiBold"/></Border>
                <Border Style="{StaticResource Card}" Padding="0"><ItemsControl ItemsSource="{Binding Shell.Snapshot.Sessions}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="90"/><ColumnDefinition Width="105"/><ColumnDefinition Width="85"/><ColumnDefinition Width="70"/><ColumnDefinition Width="105"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LogicalName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Role}" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="2" Text="{Binding State}"/><TextBlock Grid.Column="3" Text="{Binding Visibility}"/><TextBlock Grid.Column="4" Text="{Binding ProcessId}"/><TextBlock Grid.Column="5" Text="{Binding LastActivity, StringFormat={}{0:HH:mm:ss}}" Style="{StaticResource MutedText}"/><StackPanel Grid.Column="6"><TextBlock Text="{Binding OwnershipStatus}" FontWeight="SemiBold"/><TextBlock Text="{Binding OwnershipReason}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="7"><TextBlock Text="{Binding ConversationOrTask}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LogicalAgentId, StringFormat={}Agent: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Heartbeat, StringFormat={}Heartbeat: {0:HH:mm:ss}}" Style="{StaticResource MutedText}"/></StackPanel><WrapPanel Grid.Column="8"><Button Content="Open" Padding="8,5" Margin="0,0,4,4" Command="{Binding DataContext.Shell.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}"/><Button Content="Front" Padding="8,5" Margin="0,0,4,4" Command="{Binding DataContext.Shell.BringSessionToFrontCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}"/><Button Content="Hide" Padding="8,5" Margin="0,0,4,4" Command="{Binding DataContext.Shell.HideSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}"/><Button Content="Restart" Padding="8,5" Margin="0,0,4,4" Command="{Binding DataContext.Shell.RestartSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}"/><Button Content="Kill" Padding="8,5" Style="{StaticResource DangerButton}" Command="{Binding DataContext.Shell.KillSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}" ToolTip="{Binding OwnershipReason}"/></WrapPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                <TextBlock Text="Kill is enabled only when Worker 3 ownership proof returns proven. Kill All skips every unproven runtime." Style="{StaticResource MutedText}" Margin="4,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
