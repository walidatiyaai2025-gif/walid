<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels"
                    xmlns:p="clr-namespace:PCCExecutive.App.Presentation">
    <!-- 10 Loop Guard -->
    <DataTemplate DataType="{x:Type vm:LoopGuardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Loop Guard &amp; Stability" Style="{StaticResource TitleText}"/><TextBlock Text="Detect repeated no-progress patterns and stop wasteful orchestration loops." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="LOOP GUARD STATUS" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.LoopGuardState}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brush.Green}" Margin="0,8,0,4"/><TextBlock Text="No state is inferred without runtime evidence." Style="{StaticResource MutedText}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="MONITORING CRITERIA" Style="{StaticResource SectionTitle}"/><TextBlock Text="Same HEAD / evidence across waves" Margin="0,9,0,2"/><TextBlock Text="Same blocker across waves" Margin="0,2"/><TextBlock Text="Low verified-progress delta" Margin="0,2"/><TextBlock Text="Repeated failed test fingerprint" Margin="0,2"/><TextBlock Text="Repeated task / reassignment" Margin="0,2"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="OUTCOME" Style="{StaticResource SectionTitle}"/><TextBlock Text="NORMAL → WATCH → STAGNATING → LOOP DETECTED → AUTO STOPPED" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,6"/><TextBlock Text="The guard may replan once, enter repair mode, or stop and escalate only when genuine operator input is needed." Style="{StaticResource MutedText}"/></StackPanel></Border></Grid>
        </StackPanel></ScrollViewer>
    </DataTemplate>
    <!-- 11 ChatGPT Health & Recovery -->
    <DataTemplate DataType="{x:Type vm:ChatGptHealthViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="ChatGPT Health &amp; Recovery" Style="{StaticResource TitleText}"/><TextBlock Text="Semantic runtime health with automatic, conservative recovery." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="GLOBAL HEALTH" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.HealthText}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding Shell.Snapshot.HealthAccent}" Margin="0,10,0,3"/><TextBlock Text="{Binding Shell.Snapshot.OperatorMessage}" Style="{StaticResource MutedText}"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="SUPPORTED RUNTIME STATES" Style="{StaticResource SectionTitle}"/><WrapPanel Margin="0,10,0,0"><Border Style="{StaticResource GreenChip}" Margin="0,0,6,6"><TextBlock Text="HEALTHY" Foreground="{StaticResource Brush.Green}"/></Border><Border Style="{StaticResource AmberChip}" Margin="0,0,6,6"><TextBlock Text="SLOW / THROTTLED" Foreground="{StaticResource Brush.Amber}"/></Border><Border Style="{StaticResource AmberChip}" Margin="0,0,6,6"><TextBlock Text="RATE LIMITED / COOLDOWN" Foreground="{StaticResource Brush.Amber}"/></Border><Border Style="{StaticResource PurpleChip}" Margin="0,0,6,6"><TextBlock Text="RECOVERING" Foreground="#D8C7FF"/></Border><Border Style="{StaticResource DangerChip}" Margin="0,0,6,6"><TextBlock Text="LOGIN / CHALLENGE" Foreground="#FFD6DE"/></Border><Border Style="{StaticResource DangerChip}" Margin="0,0,6,6"><TextBlock Text="OFFLINE / STUCK" Foreground="#FFD6DE"/></Border><Border Style="{StaticResource DangerChip}" Margin="0,0,6,6"><TextBlock Text="ADAPTER UNCERTAIN" Foreground="#FFD6DE"/></Border></WrapPanel><TextBlock Text="No fake countdowns: timing appears only when runtime supplies or derives a real value." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="RECENT RECOVERY TIMELINE" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.Snapshot.RecoveryEvents}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding State}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding At, StringFormat={}{0:HH:mm:ss}}" Style="{StaticResource MutedText}"/></Grid><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Automatic, StringFormat={}Automatic: {0}}" Foreground="{StaticResource Brush.Green}" FontSize="11"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </Grid>
        </StackPanel></ScrollViewer>
    </DataTemplate>
    <!-- 12 Session Monitor -->
    <DataTemplate DataType="{x:Type vm:SessionMonitorViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Session Monitor" Style="{StaticResource TitleText}"/><TextBlock Text="Manager + Worker 1..5 logical sessions. Personal Chrome is never assumed to be PCC-owned." Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Kill All PCC Sessions" Style="{StaticResource DangerButton}" Command="{Binding Shell.KillAllPccSessionsCommand}" ToolTip="Only proven PCC-owned sessions are eligible. A confirmation is required before execution."/></Grid>
            <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="#0F1B2C" Margin="1" Height="38"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="105"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="75"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SESSION" Style="{StaticResource SectionTitle}" Margin="12,12,0,0"/><TextBlock Grid.Column="1" Text="ROLE" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="2" Text="STATE" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="3" Text="VISIBILITY" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="4" Text="PID" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="5" Text="LAST ACTIVITY" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="6" Text="CONVERSATION / TASK" Style="{StaticResource SectionTitle}" Margin="8,12,0,0"/><TextBlock Grid.Column="7" Text="ACTIONS" Style="{StaticResource SectionTitle}" Margin="8,12,156,0"/></Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Shell.Snapshot.Sessions}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="105"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="75"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LogicalName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Role}" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource Brush.Green}"/><TextBlock Grid.Column="3" Text="{Binding Visibility}"/><TextBlock Grid.Column="4" Text="{Binding ProcessId}"/><TextBlock Grid.Column="5" Text="{Binding LastActivity, StringFormat={}{0:HH:mm:ss}}" Style="{StaticResource MutedText}"/><StackPanel Grid.Column="6"><TextBlock Text="{Binding ConversationOrTask}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding IsPccOwned, StringFormat={}PCC owned: {0}}" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Column="7" Orientation="Horizontal"><Button Content="Open" Padding="9,5" Margin="0,0,4,0" Command="{Binding DataContext.Shell.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}"/><Button Content="Bring to Front" Padding="9,5" Margin="0,0,4,0" Command="{Binding DataContext.Shell.BringSessionToFrontCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}"/><Button Content="Hide" Padding="9,5" Margin="0,0,4,0" Command="{Binding DataContext.Shell.HideSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}"/><Button Content="Restart" Padding="9,5" Margin="0,0,4,0" Command="{Binding DataContext.Shell.RestartSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}"/><Button Content="Kill" Padding="9,5" Style="{StaticResource DangerButton}" Command="{Binding DataContext.Shell.KillSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding RuntimeId}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </Grid></Border>
            <TextBlock Text="Kill controls must be enabled only by positive ownership evidence from the Browser runtime. Unknown Chrome processes are not PCC sessions." Style="{StaticResource MutedText}" Margin="4,8,0,0"/>
        </StackPanel></ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
