<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:PCCExecutive.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:ManagerWorkspaceViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Manager Workspace" Style="{StaticResource TitleText}"/><TextBlock Text="Stable logical Manager identity; browser conversations may roll over without changing the role." Style="{StaticResource MutedText}"/></StackPanel><WrapPanel Grid.Column="1"><Button Content="Conversation History" Command="{Binding Shell.ToggleConversationHistoryCommand}" Margin="0,0,8,8"/><Button Content="Open Manager Chat" Style="{StaticResource PrimaryButton}" Command="{Binding Shell.OpenSessionCommand}" CommandParameter="{Binding Shell.ManagerSession.RuntimeId}" Margin="0,0,8,8"/><Button Content="Bring to Front" Command="{Binding Shell.BringSessionToFrontCommand}" CommandParameter="{Binding Shell.ManagerSession.RuntimeId}" Margin="0,0,8,8"/></WrapPanel></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="LATEST STRUCTURED MANAGER RESPONSE / HANDOFF" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.LatestManagerHandoff}" Margin="0,12,0,0" FontSize="14" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CURRENT EXECUTION CONTEXT" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.CurrentExecutionFlow}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="The WPF shell shows structured orchestration state. Open the actual PCC-owned browser chat when full ChatGPT rendering is needed." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MANAGER CONTROLS" Style="{StaticResource SectionTitle}"/><WrapPanel Margin="0,10,0,0"><Button Content="Pause AI" Command="{Binding Shell.PauseAiCommand}" ToolTip="{Binding Shell.PauseAiDisabledReason}" Margin="0,0,8,8"/><Button Content="Resume" Command="{Binding Shell.ResumeAiCommand}" ToolTip="{Binding Shell.PauseAiDisabledReason}" Margin="0,0,8,8"/><Button Content="Request Plan" Command="{Binding Shell.RequestManagerPlanCommand}" ToolTip="{Binding Shell.RequestPlanDisabledReason}" Margin="0,0,8,8"/></WrapPanel><TextBlock Text="{Binding Shell.PauseAiDisabledReason}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LOGICAL SESSION" Style="{StaticResource SectionTitle}"/><TextBlock Text="Manager" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,3"/><TextBlock Text="{Binding Shell.ManagerSession.State}"/><TextBlock Text="{Binding Shell.ManagerSession.ConversationOrTask}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/><TextBlock Text="{Binding Shell.ManagerSession.Health, StringFormat={}Health: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="COMPLETION SIGNALS" Style="{StaticResource SectionTitle}"/><TextBlock Text="Manager Estimate" Style="{StaticResource MutedText}" Margin="0,8,0,0"/><TextBlock Text="{Binding Shell.Snapshot.ManagerEstimateText}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Verified Completion" Style="{StaticResource MutedText}" Margin="0,10,0,0"/><TextBlock Text="{Binding Shell.Snapshot.VerifiedCompletionText}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brush.Purple}"/><TextBlock Text="{Binding Shell.Snapshot.CompletionMode}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></Border></StackPanel></Grid>
            <Border Style="{StaticResource Card}" Visibility="{Binding Shell.ShowConversationHistory, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="CONVERSATION HISTORY" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.Snapshot.Conversations}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Sequence, StringFormat={}#{0}}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding State}"/><TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat={}{0:g}}" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="3" Text="{Binding RetiredAt, StringFormat={}{0:g}}" Style="{StaticResource MutedText}"/><TextBlock Grid.Column="4" Text="{Binding RolloverReason}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </StackPanel></ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WorkersDispatchViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Workers Dispatch" Style="{StaticResource TitleText}"/><TextBlock Text="Manual · Assisted · Automatic Staged. Runtime configuration is authoritative; unsupported mutation stays disabled with a reason." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DISPATCH SETTINGS" Style="{StaticResource SectionTitle}"/><TextBlock Text="Mode" Style="{StaticResource MutedText}" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding Shell.DispatchModes}" SelectedItem="{Binding Shell.SelectedDispatchMode}" IsEnabled="{Binding Shell.CanConfigureDispatch}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Base interval"/><TextBlock Grid.Column="1" Text="{Binding Shell.Snapshot.DispatchSettings.BaseIntervalSeconds, StringFormat={}{0} sec}" FontWeight="SemiBold"/></Grid><CheckBox Content="Adaptive Pacing" IsChecked="{Binding Shell.Snapshot.DispatchSettings.AdaptivePacing}" IsHitTestVisible="False"/><CheckBox Content="Auto Pause on Limit" IsChecked="{Binding Shell.Snapshot.DispatchSettings.AutoPauseOnLimit}" IsHitTestVisible="False"/><CheckBox Content="Auto Resume" IsChecked="{Binding Shell.Snapshot.DispatchSettings.AutoResume}" IsHitTestVisible="False"/><CheckBox Content="Duplicate Send Protection" IsChecked="{Binding Shell.Snapshot.DispatchSettings.DuplicateSendProtection}" IsHitTestVisible="False"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Max Workers"/><TextBlock Grid.Column="1" Text="{Binding Shell.Snapshot.DispatchSettings.MaxWorkers}" FontWeight="SemiBold"/></Grid></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="WORKERS DISPATCH QUEUE" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.Snapshot.Workers}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CompactListItem}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LogicalName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Role}" Style="{StaticResource MutedText}"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding CurrentTask}"/><TextBlock Text="{Binding DispatchState}" Style="{StaticResource MutedText}"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding State}" Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="No countdown is fabricated. Timing appears only when supplied or derived by runtime pacing state." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
            <StackPanel Grid.Column="2"><Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="DISPATCH CONTROL" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.Snapshot.RuntimeStatus}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4" TextWrapping="Wrap"/><Button Content="Start / Resume Dispatch" Style="{StaticResource PrimaryButton}" Margin="0,12,0,8" Command="{Binding Shell.StartDispatchCommand}" ToolTip="{Binding Shell.StartDispatchDisabledReason}"/><Button Content="Pause Dispatch" Command="{Binding Shell.PauseDispatchCommand}" ToolTip="{Binding Shell.StartDispatchDisabledReason}"/><TextBlock Text="{Binding Shell.StartDispatchDisabledReason}" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LIMIT POLICY" Style="{StaticResource SectionTitle}"/><TextBlock Text="Global rate limits pause unsafe new sends. Existing safe generations may continue. No blind duplicate retry." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
        </Grid></StackPanel></ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WorkerChatViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Worker Chat" Style="{StaticResource TitleText}"/><TextBlock Text="Logical Worker identity survives browser/conversation rollover. Full ChatGPT rendering remains in the owned browser." Style="{StaticResource MutedText}"/></StackPanel><WrapPanel Grid.Column="1"><Button Content="Open Chat" Style="{StaticResource PrimaryButton}" Command="{Binding Shell.OpenSessionCommand}" CommandParameter="{Binding Shell.SelectedWorkerSession.RuntimeId}" Margin="0,0,6,6"/><Button Content="Bring to Front" Command="{Binding Shell.BringSessionToFrontCommand}" CommandParameter="{Binding Shell.SelectedWorkerSession.RuntimeId}" Margin="0,0,6,6"/><Button Content="Hide" Command="{Binding Shell.HideSessionCommand}" CommandParameter="{Binding Shell.SelectedWorkerSession.RuntimeId}" Margin="0,0,6,6"/><Button Content="Restart Session" Command="{Binding Shell.RestartSessionCommand}" CommandParameter="{Binding Shell.SelectedWorkerSession.RuntimeId}" Margin="0,0,6,6"/><Button Content="Kill Session" Style="{StaticResource DangerButton}" Command="{Binding Shell.KillSessionCommand}" CommandParameter="{Binding Shell.SelectedWorkerSession.RuntimeId}" Margin="0,0,6,6"/></WrapPanel></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WORKERS" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding Shell.Snapshot.Workers}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.Shell.SelectWorkerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,0,6" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="{Binding LogicalName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Role}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding State}" Foreground="{StaticResource Brush.Green}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <StackPanel Grid.Column="1"><Border Style="{StaticResource HeroCard}"><StackPanel><TextBlock Text="CURRENT TASK" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.SelectedWorker.CurrentTask}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding Shell.SelectedWorker.TaskScope, StringFormat={}Scope: {0}}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/><TextBlock Text="{Binding Shell.SelectedWorker.DispatchState, StringFormat={}Dispatch: {0}}" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LATEST STRUCTURED RESPONSE / HANDOFF" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.SelectedWorker.LatestHandoff}" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Shell.SelectedWorker.Blocker, StringFormat={}Blocker: {0}}" Foreground="{StaticResource Brush.Amber}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
            <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WORKER / LINEAGE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.SelectedWorker.LogicalName}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="{Binding Shell.SelectedWorker.LogicalAgentId, StringFormat={}LogicalAgentId: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.SelectedWorker.ConversationId, StringFormat={}Conversation: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.SelectedWorker.Health, StringFormat={}Health: {0}}" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SOURCE EVIDENCE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Shell.SelectedWorker.Branch, StringFormat={}Branch: {0}}" Margin="0,8,0,0"/><TextBlock Text="{Binding Shell.SelectedWorker.PullRequest, StringFormat={}PR: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.SelectedWorker.HeadSha, StringFormat={}HEAD: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Shell.SelectedWorker.Progress, StringFormat={}Worker progress: {0}%}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Brush.Cyan}" Margin="0,10,0,0"/><TextBlock Text="Worker progress is never substituted for Verified Completion." Style="{StaticResource MutedText}"/></StackPanel></Border></StackPanel>
        </Grid></StackPanel></ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
