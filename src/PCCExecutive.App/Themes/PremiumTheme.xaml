<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Approved PCC Executive dark/navy + purple visual system. -->
    <Color x:Key="Color.Background">#050A13</Color>
    <Color x:Key="Color.Nav">#07111E</Color>
    <Color x:Key="Color.Surface">#0B1625</Color>
    <Color x:Key="Color.SurfaceAlt">#101D30</Color>
    <Color x:Key="Color.Border">#1C2D42</Color>
    <Color x:Key="Color.BorderStrong">#2B3F59</Color>
    <Color x:Key="Color.Text">#F4F7FB</Color>
    <Color x:Key="Color.Muted">#8FA3B8</Color>
    <Color x:Key="Color.Purple">#8B5CF6</Color>
    <Color x:Key="Color.PurpleDeep">#6D28D9</Color>
    <Color x:Key="Color.Green">#6EE7B7</Color>
    <Color x:Key="Color.Cyan">#38BDF8</Color>
    <Color x:Key="Color.Amber">#FBBF24</Color>
    <Color x:Key="Color.Red">#FB7185</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Nav" Color="{StaticResource Color.Nav}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}"/>
    <SolidColorBrush x:Key="Brush.Purple" Color="{StaticResource Color.Purple}"/>
    <SolidColorBrush x:Key="Brush.PurpleDeep" Color="{StaticResource Color.PurpleDeep}"/>
    <SolidColorBrush x:Key="Brush.Green" Color="{StaticResource Color.Green}"/>
    <SolidColorBrush x:Key="Brush.Cyan" Color="{StaticResource Color.Cyan}"/>
    <SolidColorBrush x:Key="Brush.Amber" Color="{StaticResource Color.Amber}"/>
    <SolidColorBrush x:Key="Brush.Red" Color="{StaticResource Color.Red}"/>

    <LinearGradientBrush x:Key="Brush.PurpleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6D28D9" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="0.56"/>
        <GradientStop Color="#4F46E5" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Background}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#111C30" Offset="0"/>
                    <GradientStop Color="#0A1322" Offset="0.62"/>
                    <GradientStop Color="#17102E" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#342A58"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Purple}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.82"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.PurpleGradient}"/>
        <Setter Property="BorderBrush" Value="#9D7DFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#34131C"/>
        <Setter Property="BorderBrush" Value="#7F1D32"/>
        <Setter Property="Foreground" Value="#FFD6DE"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="#07111E"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Margin" Value="0,6,0,6"/>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Background" Value="#19243A"/>
        <Setter Property="BorderBrush" Value="#283A55"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="GreenChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="#0E2A25"/>
        <Setter Property="BorderBrush" Value="#1B5A4C"/>
    </Style>

    <Style x:Key="PurpleChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="#24163F"/>
        <Setter Property="BorderBrush" Value="#5B35A4"/>
    </Style>

    <Style x:Key="AmberChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="#30230A"/>
        <Setter Property="BorderBrush" Value="#7A5B14"/>
    </Style>

    <Style x:Key="DangerChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="#36121B"/>
        <Setter Property="BorderBrush" Value="#7F1D32"/>
    </Style>

    <Style x:Key="SeparatorLine" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Brush.Border}"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>
</ResourceDictionary>
