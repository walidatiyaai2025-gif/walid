    <ProjectReference Include="..\PCCExecutive.Infrastructure\PCCExecutive.Infrastructure.csproj" />
    <ProjectReference Include="..\PCCExecutive.Browser\PCCExecutive.Browser.csproj" />
    <ProjectReference Include="..\PCCExecutive.Pcc\PCCExecutive.Pcc.csproj" />
    <ProjectReference Include="..\PCCExecutive.GitHub\PCCExecutive.GitHub.csproj" />
  </ItemGroup>
</Project>
